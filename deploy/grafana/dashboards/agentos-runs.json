{
  "uid": "agentos-runs",
  "title": "AgentOS — Runs, Cost, Approvals",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {"from": "now-1h", "to": "now"},
  "tags": ["agentos"],
  "panels": [
    {"id": 1, "type": "stat", "title": "Runs / min", "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
     "datasource": {"uid": "agentos-prom"},
     "targets": [{"expr": "sum(rate(agentos_runs_ended_total[5m])) * 60", "refId": "A"}]},
    {"id": 2, "type": "stat", "title": "Error rate", "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
     "datasource": {"uid": "agentos-prom"},
     "fieldConfig": {"defaults": {"unit": "percentunit"}},
     "targets": [{"expr": "sum(rate(agentos_runs_ended_total{outcome!=\"completed\"}[5m])) / clamp_min(sum(rate(agentos_runs_ended_total[5m])), 1e-9)", "refId": "A"}]},
    {"id": 3, "type": "stat", "title": "Awaiting approval", "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
     "datasource": {"uid": "agentos-prom"},
     "targets": [{"expr": "sum(agentos_runs_suspended)", "refId": "A"}]},
    {"id": 4, "type": "stat", "title": "Cost (USD, total)", "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
     "datasource": {"uid": "agentos-prom"},
     "fieldConfig": {"defaults": {"unit": "currencyUSD", "decimals": 4}},
     "targets": [{"expr": "sum(agentos_cost_total{currency=\"USD\"})", "refId": "A"}]},

    {"id": 5, "type": "timeseries", "title": "Run latency p50 / p95 / p99", "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
     "datasource": {"uid": "agentos-prom"},
     "fieldConfig": {"defaults": {"unit": "s"}},
     "targets": [
       {"expr": "histogram_quantile(0.5, sum by (le) (rate(agentos_run_duration_seconds_bucket[5m])))", "legendFormat": "p50", "refId": "A"},
       {"expr": "histogram_quantile(0.95, sum by (le) (rate(agentos_run_duration_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "B"},
       {"expr": "histogram_quantile(0.99, sum by (le) (rate(agentos_run_duration_seconds_bucket[5m])))", "legendFormat": "p99", "refId": "C"}]},
    {"id": 6, "type": "timeseries", "title": "Step outcomes / s", "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
     "datasource": {"uid": "agentos-prom"},
     "targets": [{"expr": "sum by (outcome) (rate(agentos_steps_ended_total[5m]))", "legendFormat": "{{outcome}}", "refId": "A"}]},

    {"id": 7, "type": "timeseries", "title": "Retries scheduled & dead-letters / s", "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
     "datasource": {"uid": "agentos-prom"},
     "targets": [
       {"expr": "sum by (step) (rate(agentos_step_retries_scheduled_total[5m]))", "legendFormat": "retry {{step}}", "refId": "A"},
       {"expr": "sum by (step, effect_class) (rate(agentos_steps_dead_lettered_total[5m]))", "legendFormat": "dead-letter {{step}} {{effect_class}}", "refId": "B"}]},
    {"id": 8, "type": "timeseries", "title": "Tokens / s by executor", "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
     "datasource": {"uid": "agentos-prom"},
     "targets": [{"expr": "sum by (agent, meter) (rate(agentos_meter_units_total{meter=~\".*tokens\"}[5m]))", "legendFormat": "{{agent}} {{meter}}", "refId": "A"}]},

    {"id": 9, "type": "timeseries", "title": "Approval wait p95 by decision", "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
     "datasource": {"uid": "agentos-prom"},
     "fieldConfig": {"defaults": {"unit": "s"}},
     "targets": [{"expr": "histogram_quantile(0.95, sum by (le, decision) (rate(agentos_approval_wait_seconds_bucket[1h])))", "legendFormat": "{{decision}}", "refId": "A"}]},
    {"id": 10, "type": "timeseries", "title": "Cost / min by workflow", "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8},
     "datasource": {"uid": "agentos-prom"},
     "fieldConfig": {"defaults": {"unit": "currencyUSD"}},
     "targets": [{"expr": "sum by (workflow) (rate(agentos_cost_total[5m])) * 60", "legendFormat": "{{workflow}}", "refId": "A"}]}
  ]
}
