# Store: AGENTOS_STORE=memory|sqlite|postgres (default sqlite → ./agentos.db, AGENTOS_SQLITE_PATH)
AGENTOS_STORE=sqlite
# Run snapshots (C15): cache the folded state every N events so a resume reads at most N.
# 0 disables (every read folds the whole log). Snapshots are a cache, never the truth.
# AGENTOS_SNAPSHOT_EVERY=200
# Run stream (GET /runs/{id}/stream, SSE over the log): store poll interval, idle
# keep-alive comment interval, and the hard connection bound (client resumes via Last-Event-ID).
# AGENTOS_STREAM_POLL_SECONDS=0.25
# AGENTOS_STREAM_KEEPALIVE_SECONDS=15
# AGENTOS_STREAM_MAX_SECONDS=3600
# Authentication (Phase 8 #1). Default `asserted` records the body's principal unverified and
# warns at startup. `bearer` requires `Authorization: Bearer <token>` on every request except
# /health and /metrics; tokens resolve to principals through a file of SHA-256 hashes:
#   {"principals": [{"sha256": "<hex of token>", "kind": "human", "id": "amit"}]}
# AGENTOS_AUTH=bearer
# AGENTOS_AUTH_TOKENS=./tokens.json
# Operator policy ceiling (Phase 8 #2): every workflow budget is intersected with this file
# before the gate sees it — tightest wins, a policy can only narrow. Unset → warns, no ceiling.
# See examples/operator_policy.json and agentos/core/policy.py.
# AGENTOS_POLICY=./examples/operator_policy.json
# Chain seals (Phase 8 #3): every idle/terminal event is followed by an HMAC seal under a key
# the DB host does not hold. Keyring: {"active": "k1", "keys": {"k1": "$(openssl rand -hex 32)"}}
# Unset → chains hash-linked but unsigned (warns). Verify with `agentos verify`.
# AGENTOS_SIGNING_KEYS=./signing-keys.json
# For Postgres (docker compose up -d):
# AGENTOS_STORE=postgres
# AGENTOS_PG_DSN=postgresql://agentos:agentos@localhost:5432/agentos
# Observability (docs/quickstart-llm.md §8)
# AGENTOS_OTEL_EXPORTER=otlp
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# AGENTOS_PROMETHEUS=1
# Providers (all optional; the default is a local Ollama with no key)
# AGENTOS_OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
